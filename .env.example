# Optional keys for chain-scout — everything works without these.
# Copy to .env (git-ignored) or export; the app reads env vars directly.

# Full-history approvals/transfers/holder analytics (free Etherscan tier).
# Without it, live scans report balances only, and note it in the report.
ETHERSCAN_API_KEY=

# LLM-written plain-English report (any OpenAI-compatible endpoint).
# Without it, the deterministic rule reporter writes the report.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Live-scan RPC (defaults to Sepolia publicnode). Mainnet additionally
# requires MAINNET_ALLOWED=1 (testnet-first design — explicit opt-in).
# CHAIN_SCOUT_RPC_URL=
# MAINNET_ALLOWED=1